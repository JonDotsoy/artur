{
  "name": "artur",
  "description": "Framework to write lite apps",
  "version": "1.6.0",
  "type": "module",
  "module": "./lib/esm/index.js",
  "main": "./lib/cjs/index.js",
  "types": "./lib/types/index.d.ts",
  "license": "MIT",
  "typesVersions": {
    "*": {
      "*": [
        "./lib/types/*"
      ]
    }
  },
  "exports": {
    ".": {
      "import": "./lib/esm/index.js",
      "require": "./lib/cjs/index.js",
      "types": "./lib/types/index.d.ts",
      "default": "./lib/esm/index.js"
    },
    "./http": {
      "import": "./lib/esm/http/index.js",
      "require": "./lib/cjs/http/index.js",
      "types": "./lib/types/http/index.d.ts",
      "default": "./lib/esm/http/index.js"
    },
    "./http/router": {
      "import": "./lib/esm/http/router.js",
      "require": "./lib/cjs/http/router.js",
      "types": "./lib/types/http/router.d.ts",
      "default": "./lib/esm/http/router.js"
    },
    "./http/access-control": {
      "import": "./lib/esm/http/access-control.js",
      "require": "./lib/cjs/http/access-control.js",
      "types": "./lib/types/http/access-control.d.ts",
      "default": "./lib/esm/http/access-control.js"
    },
    "./json-rpc": {
      "import": "./lib/esm/json-rpc/index.js",
      "require": "./lib/cjs/json-rpc/index.js",
      "types": "./lib/types/json-rpc/index.d.ts",
      "default": "./lib/esm/json-rpc/index.js"
    }
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/event-source-polyfill": "^1.0.5",
    "dispose-with-controller": "^0.1.1",
    "event-source-polyfill": "^1.0.31",
    "expect-type": "^1.1.0",
    "prettier": "^3.2.5"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@jondotsoy/decorate": "^0.1.4",
    "@jondotsoy/symbol.initialize": "^0.1.2",
    "@jondotsoy/utils-js": "^0.15.0",
    "urlpattern-polyfill": "^10.0.0",
    "zod": "^4.1.0"
  },
  "scripts": {
    "prepack": "make build",
    "fmt": "prettier -w ."
  },
  "files": [
    "./lib"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/JonDotsoy/artur.git"
  },
  "keywords": [
    "framework",
    "router"
  ]
}
